component Let {
  let one = 1;
  let two = one;
  two
}

component UnboundIdentifier {
  let two = one;
  two
}

component Shadowing {
  let a = 1;
  let a = a + 1;
  a
}

component LocalBindings {
  let f = fn () -> {
    let n = 21;
    n
  };

  f()
}

component MutableBindings {
  let mutable a = "wrong";
  if (true) {
    a := "correct";
  };

  let mutable b = "wrong";
  let get_b = fn () -> b;
  b := "correct";

  let mutable c = "correct";
  let get_c = fn () -> c;
  let mutable c = "wrong";
  c := "wrong";

  [a, get_b(), get_c()]
}

component WrongMutation {
  let a = "";
  if (true) {
    a := "error!";
  };
  a
}
