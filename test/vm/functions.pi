component FunctionEmpty {
  let noop = fn () -> {

  };

  noop()
}

component Function {
  let onePlusTwo = fn () -> {
    let one = 1;
    let two = 2;
    one + two
  };

  onePlusTwo()
}

component FunctionCurried {
  let returns_one = fn () -> if (true) 1 else 2;
  let returns_returns_one = fn () -> returns_one;

  returns_returns_one()()
}

component FunctionScope {
  let trap = "123";
  let globalSeed = 50;

  let minusOne = fn () -> {
    let n = 1;
    globalSeed - n
  };

  let minusTwo = fn () -> {
    let n = 2;
    globalSeed - n
  };

  minusOne() + minusTwo()
}

component FunctionArguments {
  let add = fn (a, b) -> a + b;

  let addOne = fn (arg) -> {
    let one = 1;
    add(arg, one)
  };

  addOne(4) + addOne(9)
}

component FunctionTooManyArguments {
  let add = fn (a, b) -> a + b;

  add(4, 5, 6)
}

component FunctionTooFewArguments {
  let add = fn (a, b) -> a + b;

  add(4)
}
