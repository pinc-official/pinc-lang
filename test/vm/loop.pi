component Loop {
  let array = [1, 2, 3, 4, 5];
  for (index, item in array) {
    item * index
  }
}

component LoopNested {
  let array = [[1, 2], [3, 4], [5, 6]];
  for (index, items in array) {
    for (index2, item in items) {
      index + index2 + item
    }
  }
}

component LoopContinue {
  let array = [1, 2, 3, 4, 5, 6, 7, 8];
  for (item in array) {
    if (item % 2 != 0) {
      continue;
    };
    item
  }
}

component LoopBreak {
  let array = [1, 2, 3, 4, 5, 6, 7, 8];
  for (index, item in array) {
    if (index == 3) {
      break;
    };
    item
  }
}

component LoopBreakNested {
  let array = [1, 2, 3, 4, 5, 6, 7, 8];
  for (n in 1...3) {
    if (n > 2) {
      break;
    };
    for (item in array) {
      if (n == 2 && item == 4) {
        break;
      };
      item
    }
  }
}
